generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ServiceOrder {
  id          String   @id @default(uuid())
  companyId   String
  description String
  priority    String
  value       Decimal  @db.Decimal(10, 2)
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

