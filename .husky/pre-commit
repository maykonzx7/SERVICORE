#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Backend validation
cd backend
echo "📦 Validating backend..."
npm run validate || {
  echo "❌ Backend validation failed"
  exit 1
}

# Frontend lint
cd ../frontend
echo "📦 Linting frontend..."
npm run lint || {
  echo "❌ Frontend lint failed"
  exit 1
}

echo "✅ All pre-commit checks passed!"

